// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  guest
  member
  admin
}

enum PlanType {
  free
  plus
}

enum SessionMode {
  daily_guidance
  emotion_question
  card_draw
}

enum SessionCategory {
  relationship
  stress
  career
  self_doubt
  sleep
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(member)
  planType     PlanType  @default(free) @map("plan_type")
  sessions     Session[]
  usageLimits  UsageLimit[]
  subscriptions Subscription[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id                 String          @id @default(cuid())
  userId             String?         @map("user_id")
  guestToken         String?         @map("guest_token")
  mode               SessionMode
  category           SessionCategory
  userInput          String          @default("") @map("user_input")
  moodScore          Int?            @map("mood_score")
  cardId             String?         @map("card_id")
  responseTitle      String          @map("response_title")
  responseEmpathy    String          @map("response_empathy")
  responseReflection String          @map("response_reflection")
  responseAction     String          @map("response_action")
  safetyFlag         Boolean         @default(false) @map("safety_flag")
  title              String?
  tags               String[]        @default([])
  emotionScore       Int?            @map("emotion_score")
  isPublic           Boolean         @default(false) @map("is_public")
  metadata           Json?
  createdAt          DateTime        @default(now()) @map("created_at")
  card               Card?           @relation(fields: [cardId], references: [id])
  messages           ChatMessage[]
  user               User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isPublic, createdAt])
  @@index([guestToken])
  @@map("sessions")
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  role      String
  content   String
  safetyFlag Boolean @default(false) @map("safety_flag")
  isEdited  Boolean  @default(false) @map("is_edited")
  editedAt  DateTime? @map("edited_at")
  aiConfidence Float? @map("ai_confidence")
  createdAt DateTime @default(now()) @map("created_at")
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  feedback  Feedback[]

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model UsageLimit {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  guestToken   String?  @map("guest_token")
  date         String
  messageCount Int      @default(0) @map("message_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([guestToken, date])
  @@map("usage_limits")
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  plan      PlanType
  status    String
  startedAt DateTime  @map("started_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("subscriptions")
}

model Feedback {
  id        String       @id @default(cuid())
  userId    String?      @map("user_id")
  sessionId String       @map("session_id")
  messageId String?      @map("message_id")
  rating    Int
  reason    String?
  createdAt DateTime     @default(now()) @map("created_at")
  message   ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([messageId])
  @@map("feedback")
}

model Card {
  id              String    @id @default(cuid())
  name            String    @unique
  uprightMeaning  String    @map("upright_meaning")
  reversedMeaning String    @map("reversed_meaning")
  categoryHint    String    @map("category_hint")
  sessions        Session[]

  @@map("cards")
}
